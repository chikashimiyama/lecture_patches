#N canvas 100 80 820 600 12;
#X text 30 15 6. 確率をコントロールする ── [random 100] + [moses];
#N canvas 0 50 450 250 (subpatch) 0;
#X array kick 100 float 2;
#X coords 0 1 100 -1 160 70 1 0 0;
#X restore 430 60 graph;
#N canvas 0 50 450 250 (subpatch) 0;
#X array snare 100 float 2;
#X coords 0 1 100 -1 160 70 1 0 0;
#X restore 430 170 graph;
#X obj 430 270 loadbang;
#X msg 430 300 read -resize kick.wav kick \, read -resize snare.wav snare;
#X obj 430 350 soundfiler;
#X obj 50 100 metro 125;
#X obj 50 60 tgl 25 0 empty empty empty 17 7 0 10 -262144 -1 -1 0 1;
#X obj 50 140 random 100;
#X obj 50 180 moses 20;
#X obj 170 220 moses 70;
#X obj 50 260 bang;
#X obj 170 260 bang;
#X obj 50 300 tabplay~ snare;
#X obj 170 300 tabplay~ kick;
#X obj 50 340 *~ 0.5;
#X obj 50 380 dac~;
#X floatatom 140 150 5 0 0 0 - - - 0;
#X floatatom 280 190 5 0 0 0 - - - 0;
#X text 290 225 70以上は何も鳴らない = 休符30%;
#X text 190 150 ← しきい値を変える;
#X text 50 430 0〜19 (20%) → スネア / 20〜69 (50%) → キック / 70〜99 (30%) → 休符;
#X text 50 455 kick.wav と snare.wav をこのパッチと同じフォルダに置く;
#X msg 430 430 \; pd dsp 1;
#X msg 520 430 \; pd dsp 0;
#X text 430 460 DSP オン / オフ;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 7 0 6 0;
#X connect 6 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 11 0;
#X connect 9 1 10 0;
#X connect 10 0 12 0;
#X connect 11 0 13 0;
#X connect 12 0 14 0;
#X connect 13 0 15 0;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
